@model LogIn_ADO.NET_Version.Models.competencia

@{
    ViewData["Title"] = "EditAC";
}

<h1>EditAC</h1>

<h4>competencia</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditAC">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input asp-for="IDC" class="form-control" hidden />
            </div>
            <div class="form-group">
                <label asp-for="Nombre_C" class="control-label"></label>
                <input asp-for="Nombre_C" class="form-control" />
                <span asp-validation-for="Nombre_C" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Competencia" class="control-label"></label>
                <input asp-for="Competencia" class="form-control" />
                <span asp-validation-for="Competencia" class="text-danger"></span>
            </div>
            @Html.HiddenFor(m => m.IDU)
            <div class="form-group">
                <input asp-for="IDU" class="form-control" hidden />
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <!-- Pasar el IDU al volver a la lista -->
    <a asp-action="IndexAC" asp-route-id="@Model.IDU">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
