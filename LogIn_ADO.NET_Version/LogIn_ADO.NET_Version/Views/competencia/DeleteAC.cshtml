@model LogIn_ADO.NET_Version.Models.competencia

@{
    ViewData["Title"] = "DeleteAC";
}

<h1>DeleteAC</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>competencia</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IDC)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IDC)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre_C)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre_C)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Competencia)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Competencia)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IDU)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IDU)
        </dd>
    </dl>

    <form asp-action="DeleteAC">
        <input type="hidden" name="IDC" value="@Model.IDC" />
        <input type="hidden" name="IDU" value="@Model.IDU" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
    </form>
</div>

<div>
    <!-- Pasar el IDU al volver a la lista -->
    <a asp-action="IndexAC" asp-route-id="@Model.IDU">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
