@model IEnumerable<LogIn_ADO.NET_Version.Models.usser>

@{
    ViewData["Title"] = "IndexA";
}

<h1>IndexA</h1>

<p>
    <a asp-action="CreateAU">Crear admin o usuario</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IDU)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Correo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Adm)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IDU)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Correo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Adm)
            </td>

            <td>
                @Html.ActionLink("Editar", "EditAU", new {  id=item.IDU}) |
                    @Html.ActionLink("Competencias", "CompetenciaA", new { id = item.IDU }) |
                @Html.ActionLink("Eliminar", "DeleteAU", new { id=item.IDU  })
            </td>
        </tr>
}
    </tbody>
</table>
