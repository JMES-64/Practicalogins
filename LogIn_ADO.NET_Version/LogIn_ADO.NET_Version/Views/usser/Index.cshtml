@model IEnumerable<LogIn_ADO.NET_Version.Models.usser>

@{
    ViewData["Title"] = "Index";
}

<h1>Indice</h1>

<p>
    <a asp-action="CreateU">Crear usuario</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IDU)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Correo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IDU)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Correo)
            </td>
            <td>
                @Html.ActionLink("Editar", "EditU", new { id=item.IDU}) |
                    @Html.ActionLink("Competencias", "Competencia", new { id = item.IDU }) |
                @Html.ActionLink("Borrar", "Delete", new { id=item.IDU})
            </td>
        </tr>
}
    </tbody>
</table>
